{
  "name": "revotale",
  "version": "1.0.0",
  "description": "RevoTale Admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --experimental-build-mode compile --experimental-app-only --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix .",
    "tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "pnpm run tsc && pnpm run lint",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "payload",
    "generate": "PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:types && PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:importmap && PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:graphQLSchema && PAYLOAD_PUBLIC_SERVER_URL=https://localhost PAYLOAD_SECRET=dsfsfdfsd pnpm run generate:db-schema",
    "generate:types": "payload generate:types",
    "generate:db-schema": "payload generate:db-schema",
    "migrate:is-up-to-date": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm payload migrate:create --check",
    "generate:importmap": "payload generate:importmap",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema",
    "migrate:create": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm payload migrate:create --skip-empty"
  },
  "dependencies": {
    "@lexical/code": "^0.38.2",
    "@lexical/link": "^0.38.2",
    "@lexical/list": "^0.38.2",
    "@lexical/markdown": "^0.38.2",
    "@lexical/react": "^0.38.2",
    "@lexical/rich-text": "^0.38.2",
    "@lexical/table": "^0.38.2",
    "@mdxeditor/editor": "^3.48.0",
    "@payloadcms/db-postgres": "^3.62.0",
    "@payloadcms/graphql": "3.65.0",
    "@payloadcms/next": "3.65.0",
    "@payloadcms/plugin-cloud-storage": "^3.62.0",
    "@payloadcms/plugin-search": "^3.62.0",
    "@payloadcms/plugin-seo": "3.65.0",
    "@payloadcms/storage-s3": "3.65.0",
    "@payloadcms/ui": "3.65.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql": "^16.11.0",
    "lexical": "^0.38.2",
    "lucide-react": "^0.555.0",
    "next": "16.0.7",
    "openai": "^6.7.0",
    "payload": "3.65.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark": "^15.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "16.0.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "9.39.1",
    "eslint-config-love": "^136.0.0",
    "eslint-config-nice-nextjs": "^0.4.0",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "es5-ext",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
