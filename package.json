{
  "name": "revotale",
  "version": "1.0.0",
  "description": "RevoTale Admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --experimental-build-mode compile --experimental-app-only",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "pnpm run tsc && pnpm run lint",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "payload",
    "generate": "pnpm run generate:types && pnpm run generate:importmap && pnpm run generate:graphQLSchema",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema"
  },
  "dependencies": {
    "@ai-stack/payloadcms": "3.2.11-beta",
    "@payloadcms/db-mongodb": "3.34.0",
    "@payloadcms/graphql": "3.34.0",
    "@payloadcms/live-preview-react": "3.34.0",
    "@payloadcms/next": "3.34.0",
    "@payloadcms/plugin-cloud-storage": "3.34.0",
    "@payloadcms/plugin-form-builder": "3.34.0",
    "@payloadcms/plugin-nested-docs": "3.34.0",
    "@payloadcms/plugin-redirects": "3.34.0",
    "@payloadcms/plugin-seo": "3.34.0",
    "@payloadcms/richtext-lexical": "3.34.0",
    "@payloadcms/storage-s3": "3.34.0",
    "@payloadcms/ui": "3.34.0",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.3.1",
    "graphql": "^16.10.0",
    "jsonwebtoken": "9.0.2",
    "lexical": "0.28.0",
    "lucide-react": "^0.487.0",
    "next": "15.3.0",
    "openai": "^4.97.0",
    "payload": "3.34.0",
    "payload-admin-bar": "^1.0.7",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "7.55.0",
    "sharp": "0.34.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.3.0",
    "@payloadcms/eslint-config": "^3.28.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.6.2"
}
