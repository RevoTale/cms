{
	"$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.next",
			"!**/node_modules",
			"!next-env.d.ts",
			"!next.config.ts",
			"!imageLoader.js",
			"!codegen.ts",
			"!global.ts",
			"!**/importMap.js",
			"!src/payload-generated-schema.ts",
			"!src/payload-types.ts",
			"!src/app/src/gql",
			"!src/app/dictionaries/**/*.d.json.ts",
			"!src/migrations",
			"!postcss.config.js",
			"!**/@shadcn/ui",
			"!**/build",
			"!**/dist",
			"!**/docs",
			"!**/temp",
			"!tsconfig.json",
			"!tsconfig.tsbuildinfo"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"next": "recommended",
			"tailwind": "recommended",
			"project": "recommended"
		},
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"complexity": {
				"recommended": true
			},
			"correctness": {
				"recommended": true
			},
			"nursery": {
				"recommended": true
			},
			"performance": {
				"recommended": true
			},
			"security": {
				"recommended": true
			},
			"style": {
				"recommended": true
			},
			"suspicious": {
				"recommended": true
			}
		}
	},
	"css": {
		"linter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"linter": {
			"enabled": true
		},
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "asNeeded",
			"trailingCommas": "all",
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true
		}
	}
}
