{
	"name": "RevoTale CMS",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"runServices": ["cms_postgres", "minio", "setup-minio", "imgproxy"],
	"workspaceFolder": "/workspaces/backend/cms",
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind"
	],
	"shutdownAction": "stopCompose",
	"features": {
		"ghcr.io/rails/devcontainer/features/bun:1": {},
		"ghcr.io/devcontainers/features/go:1": {},
		"ghcr.io/devcontainers-extra/features/go-task:1": {}
	},
	"postCreateCommand": "bun install --frozen-lockfile --backend=copyfile",
	"forwardPorts": [3000, 5432, 8080, 9000, 9001],
	"customizations": {
		"vscode": {
			"extensions": [
				"bradlc.vscode-tailwindcss",
				"GraphQL.vscode-graphql-syntax",
				"GraphQL.vscode-graphql",
				"ms-azuretools.vscode-containers",
				"golang.go",
				"biomejs.biome"
			],
			"settings": {
				"makefile.configureOnOpen": false,
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "biomejs.biome",
				"biome.enabled": true,
				"biome.requireConfiguration": true,
				"biome.lsp.bin": {
					"linux-x64": "./node_modules/@biomejs/cli-linux-x64/bin",
					"linux-arm64": "./node_modules/@biomejs/cli-linux-arm64/bin"
				},
				"editor.codeActionsOnSave": {
					"source.fixAll.biome": "explicit",
					"source.organizeImports.biome": "explicit"
				},
				"[javascript]": {
					"editor.defaultFormatter": "biomejs.biome"
				},
				"[javascriptreact]": {
					"editor.defaultFormatter": "biomejs.biome"
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "biomejs.biome"
				},
				"[typescript]": {
					"editor.defaultFormatter": "biomejs.biome"
				},
				"[json]": {
					"editor.defaultFormatter": "biomejs.biome"
				},
				"[jsonc]": {
					"editor.defaultFormatter": "biomejs.biome"
				}
			}
		}
	},
	"remoteUser": "root"
}
