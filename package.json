{
  "name": "revotale",
  "version": "0.1.1",
  "description": "RevoTale Admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --experimental-build-mode compile",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && bun run build && bun run start",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation bun install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix .",
    "tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "bun run tsc && bun run lint",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm bun.lockb && bun install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "payload --disable-transpile",
    "generate": "PAYLOAD_PUBLIC_SERVER_URL=https://localhost bun run generate:types && PAYLOAD_PUBLIC_SERVER_URL=https://localhost bun run generate:importmap && PAYLOAD_PUBLIC_SERVER_URL=https://localhost bun run generate:graphQLSchema && PAYLOAD_PUBLIC_SERVER_URL=https://localhost PAYLOAD_SECRET=dsfsfdfsd bun run generate:db-schema",
    "generate:types": "payload generate:types",
    "generate:db-schema": "payload generate:db-schema",
    "migrate:is-up-to-date": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost bun payload migrate:create --check",
    "generate:importmap": "payload generate:importmap",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema",
    "migrate:create": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost bun payload migrate:create --skip-empty"
  },
  "dependencies": {
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@mdxeditor/editor": "^3.52.3",
    "@payloadcms/db-postgres": "^3.70.0",
    "@payloadcms/graphql": "3.70.0",
    "@payloadcms/next": "3.70.0",
    "@payloadcms/plugin-cloud-storage": "^3.70.0",
    "@payloadcms/plugin-search": "^3.70.0",
    "@payloadcms/plugin-seo": "3.70.0",
    "@payloadcms/storage-s3": "3.70.0",
    "@payloadcms/ui": "3.70.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql": "^16.12.0",
    "lexical": "^0.39.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "openai": "^6.15.0",
    "payload": "3.70.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark": "^15.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/eslint-plugin-next": "16.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/node": "25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.2",
    "eslint-config-love": "^140.0.0",
    "eslint-config-nice-nextjs": "^0.4.0",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.1.40"
}
