{
  "name": "revotale",
  "version": "1.0.0",
  "description": "RevoTale Admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --experimental-build-mode compile --experimental-app-only",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix .",
    "tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "pnpm run tsc && pnpm run lint",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "payload",
    "generate": "PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:types && PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:importmap && PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm run generate:graphQLSchema && PAYLOAD_PUBLIC_SERVER_URL=https://localhost PAYLOAD_SECRET=dsfsfdfsd pnpm run generate:db-schema",
    "generate:types": "payload generate:types",
    "generate:db-schema": "payload generate:db-schema",
    "migrate:is-up-to-date": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm payload migrate:create --check",
    "generate:importmap": "payload generate:importmap",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema",
    "migrate:create": "PAYLOAD_SECRET=dsfsfdfsd PAYLOAD_PUBLIC_SERVER_URL=https://localhost pnpm payload migrate:create --skip-empty"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.58.0",
    "@payloadcms/db-postgres": "^3.58.0",
    "@payloadcms/graphql": "3.58.0",
    "@payloadcms/next": "3.58.0",
    "@payloadcms/plugin-cloud-storage": "3.58.0",
    "@payloadcms/plugin-seo": "3.58.0",
    "@payloadcms/storage-s3": "3.58.0",
    "@payloadcms/ui": "3.58.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "geist": "^1.5.1",
    "graphql": "^16.11.0",
    "jsonwebtoken": "9.0.2",
    "lexical": "0.36.2",
    "lucide-react": "^0.545.0",
    "next": "15.5.4",
    "openai": "^6.1.0",
    "payload": "3.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.64.0",
    "sharp": "0.34.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "15.5.4",
    "@payloadcms/eslint-config": "^3.28.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/node": "24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-nice-nextjs": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
